N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Europe/Moscow

# OpenAI (Whisper + LangChain chat models). Put the same key into n8n credentials UI.
OPENAI_API_KEY=

# Atlassian
JIRA_BASE_URL=https://your-domain.atlassian.net
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
CONFLUENCE_SPACE_KEY=ARCH

# Slack incoming webhook for architect notifications (no token in workflow JSON)
SLACK_WEBHOOK_URL=
SLACK_PUBLISH_WEBHOOK_URL=

# Microsoft Teams incoming webhook
TEAMS_WEBHOOK_URL=

# Notion
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name
